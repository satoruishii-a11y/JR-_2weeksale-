{
  "id": "bumper-6s",
  "name": "バンパー6秒（2カット）",
  "version": "1.0.0",
  "description": "スキップ不可の6秒枠。言えることは1メッセージだけなので、フック→オファーの2カットに絞る。完成尺は5.9秒（6.0秒だと入稿で弾かれることがあるため）。",
  "fps": 30,
  "hookType": "${axis.hook}",

  "axes": {
    "hook": {
      "description": "冒頭の切り口",
      "values": ["price", "scarcity", "question"]
    },
    "textStyle": {
      "description": "テロップの見せ方",
      "values": ["impact", "clean"]
    }
  },

  "requiredCopy": [
    "hook.price", "hook.scarcity", "hook.question",
    "offerShort", "cta"
  ],

  "audio": { "targetLufs": -16, "volume": 0.2, "fadeIn": 0.3, "fadeOut": 0.8 },

  "defs": {
    "headline": {
      "$switch": {
        "on": "axis:textStyle",
        "cases": {
          "impact": {
            "font": "bold",
            "sizePct": { "$switch": { "on": "orientation", "cases": { "landscape": 10.5, "square": 10.0 }, "default": 9.0 } },
            "color": "${brand.accent}",
            "strokeColor": "#141414",
            "strokeWidthPct": 8,
            "letterSpacingEm": 0.01,
            "lineHeight": 1.22,
            "align": "center",
            "shadow": { "color": "rgba(0,0,0,0.55)", "blurEm": 0.18, "offsetYEm": 0.06 }
          },
          "clean": {
            "font": "bold",
            "sizePct": { "$switch": { "on": "orientation", "cases": { "landscape": 9.4, "square": 9.0 }, "default": 8.2 } },
            "color": "#FFFFFF",
            "strokeWidthPct": 0,
            "letterSpacingEm": 0.03,
            "lineHeight": 1.32,
            "align": "center",
            "band": { "color": "rgba(18,18,18,0.74)", "paddingXEm": 0.55, "paddingYEm": 0.26, "radiusEm": 0.1, "perLine": true }
          }
        }
      }
    },
    "cta": {
      "font": "bold",
      "sizePct": { "$switch": { "on": "orientation", "cases": { "landscape": 4.8, "square": 4.6 }, "default": 4.2 } },
      "color": "${brand.textOnPrimary}",
      "letterSpacingEm": 0.04,
      "lineHeight": 1.3,
      "align": "center",
      "band": { "color": "${brand.primary}", "paddingXEm": 0.9, "paddingYEm": 0.36, "radiusEm": 0.18, "perLine": false }
    },
    "y": {
      "headline": { "$switch": { "on": "orientation", "cases": { "landscape": -20, "square": -22 }, "default": -26 } },
      "cta": { "$switch": { "on": "orientation", "cases": { "landscape": -12, "square": -14 }, "default": -22 } }
    },
    "width": { "$switch": { "on": "orientation", "cases": { "landscape": 64, "square": 78 }, "default": 82 } },
    "scrim": {
      "kind": "scrim",
      "side": "bottom",
      "heightPct": 66,
      "color": "#000000",
      "strength": 0.68,
      "anim": "none",
      "start": 0
    }
  },

  "scenes": [
    {
      "id": "hook",
      "asset": "hero1",
      "duration": 2.8,
      "motion": "zoom-in",
      "motionIntensity": 0.7,
      "overlays": [
        { "$ref": "defs.scrim" },
        {
          "kind": "text",
          "role": "headline",
          "maxLines": 2,
          "text": "${copy.hook.${axis.hook}}",
          "style": { "$ref": "defs.headline" },
          "maxWidthPct": { "$ref": "defs.width" },
          "anchor": "bottom-center",
          "yPct": { "$ref": "defs.y.headline" },
          "start": 0.12,
          "anim": "slide-up",
          "animDuration": 0.28
        }
      ]
    },
    {
      "id": "close",
      "asset": "hero4",
      "duration": 3.3,
      "motion": "zoom-out",
      "motionIntensity": 0.35,
      "transitionIn": "fade",
      "transitionDuration": 0.2,
      "grade": { "brightness": -0.05, "contrast": 1.02, "saturation": 0.95, "blurPx": 0 },
      "overlays": [
        { "$ref": "defs.scrim", "heightPct": 100, "strength": 0.52, "side": "full" },
        {
          "kind": "text",
          "role": "price",
          "maxLines": 1,
          "text": "${copy.offerShort}",
          "style": { "$ref": "defs.headline" },
          "maxWidthPct": { "$ref": "defs.width" },
          "anchor": "center",
          "yPct": -8,
          "start": 0.15,
          "anim": "fade",
          "animDuration": 0.25
        }
      ]
    }
  ],

  "overlays": [
    {
      "kind": "image",
      "role": "logo",
      "file": "assets/logo.png",
      "widthPct": { "$switch": { "on": "orientation", "cases": { "landscape": 13, "square": 18 }, "default": 22 } },
      "anchor": "top-left",
      "xPct": { "$switch": { "on": "orientation", "cases": { "landscape": 6 }, "default": 8 } },
      "yPct": { "$switch": { "on": "orientation", "cases": { "landscape": 7 }, "default": 9 } },
      "start": 0.3,
      "anim": "fade",
      "animDuration": 0.4,
      "opacity": 0.95
    },
    {
      "kind": "text",
      "role": "cta",
      "maxLines": 1,
      "text": "${copy.cta}",
      "style": { "$ref": "defs.cta" },
      "maxWidthPct": { "$ref": "defs.width" },
      "anchor": "bottom-center",
      "yPct": { "$ref": "defs.y.cta" },
      "start": 3.2,
      "anim": "slide-up",
      "animDuration": 0.3,
      "outDuration": 0
    }
  ]
}
