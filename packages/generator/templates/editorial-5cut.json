{
  "id": "editorial-5cut",
  "name": "和エディトリアル15秒（実写5カット・拍同期）",
  "version": "1.0.0",
  "description": "実写素材5枚を「引き→引き→中景→寄り→クローズ」で組む型。4カットの editorial-15s が全部引きの風景で単調だったため、寄り（ディテール）のカットを入れて緩急を付けた。カット尺は $beats で BGM の拍に乗せてあり（80BPM: 5+4+3+4+6拍、繋ぎは半拍）、完成尺はちょうど15.0秒になる。中景カットには意図的にテロップを置かず、絵だけ見せて息をつく。",
  "fps": 30,
  "hookType": "${axis.hook}",

  "axes": {
    "hook": {
      "description": "冒頭3秒の切り口。何で足を止めるか",
      "values": ["price", "scarcity", "question"]
    },
    "typeStyle": {
      "description": "大見出しの組み方。縦書き明朝（和の上質）vs 横書き明朝（モダン）",
      "values": ["tate", "yoko"]
    },
    "ctaTiming": {
      "description": "CTA帯を中盤から出すか、最後だけ出すか",
      "values": ["early", "late"]
    }
  },

  "requiredCopy": [
    "kicker",
    "hook.price", "hook.scarcity", "hook.question",
    "benefit1", "benefitQuiet", "offer", "cta"
  ],

  "audio": { "bpm": 80, "targetLufs": -16, "volume": 0.16, "fadeIn": 0.8, "fadeOut": 1.8 },

  "defs": {
    "grid": { "margin": 9, "marginNeg": -9 },

    "beat": { "half": { "$beats": 0.5 } },

    "grade": {
      "brightness": -0.02,
      "contrast": 1.05,
      "saturation": 0.9,
      "blurPx": 0
    },

    "type": {
      "headlineTate": {
        "breakStrategy": "phrase",
        "font": "mincho",
        "writingMode": "vertical",
        "sizePct": { "$switch": { "on": "orientation", "cases": { "landscape": 7.4, "square": 6.8 }, "default": 6.4 } },
        "minSizePct": { "$switch": { "on": "orientation", "cases": { "landscape": 5.2, "square": 4.8 }, "default": 4.4 } },
        "color": "#FFFFFF",
        "letterSpacingEm": 0.06,
        "lineHeight": 1.78,
        "shadow": { "color": "rgba(8,6,4,0.62)", "blurEm": 0.34, "offsetXEm": 0, "offsetYEm": 0.04 }
      },
      "headlineYoko": {
        "breakStrategy": "phrase",
        "font": "mincho",
        "sizePct": { "$switch": { "on": "orientation", "cases": { "landscape": 7.6, "square": 6.4 }, "default": 5.4 } },
        "minSizePct": { "$switch": { "on": "orientation", "cases": { "landscape": 5.4, "square": 4.6 }, "default": 3.9 } },
        "color": "#FFFFFF",
        "letterSpacingEm": 0.04,
        "lineHeight": 1.5,
        "align": "left",
        "shadow": { "color": "rgba(8,6,4,0.62)", "blurEm": 0.34, "offsetXEm": 0, "offsetYEm": 0.04 }
      },
      "kicker": {
        "font": "gothicBold",
        "sizePct": { "$switch": { "on": "orientation", "cases": { "landscape": 3.0, "square": 2.7 }, "default": 2.5 } },
        "color": "${brand.accent}",
        "letterSpacingEm": 0.22,
        "lineHeight": 1.4,
        "align": "left",
        "shadow": { "color": "rgba(8,6,4,0.7)", "blurEm": 0.42, "offsetXEm": 0, "offsetYEm": 0.05 }
      },
      "body": {
        "breakStrategy": "phrase",
        "font": "gothic",
        "sizePct": { "$switch": { "on": "orientation", "cases": { "landscape": 4.2, "square": 3.8 }, "default": 3.5 } },
        "minSizePct": { "$switch": { "on": "orientation", "cases": { "landscape": 3.0, "square": 2.7 }, "default": 2.5 } },
        "color": "#FFFFFF",
        "letterSpacingEm": 0.1,
        "lineHeight": 1.7,
        "align": "left",
        "shadow": { "color": "rgba(8,6,4,0.66)", "blurEm": 0.38, "offsetXEm": 0, "offsetYEm": 0.05 }
      },
      "offer": {
        "breakStrategy": "phrase",
        "font": "minchoMid",
        "sizePct": { "$switch": { "on": "orientation", "cases": { "landscape": 5.0, "square": 4.6 }, "default": 4.2 } },
        "minSizePct": { "$switch": { "on": "orientation", "cases": { "landscape": 3.6, "square": 3.3 }, "default": 3.0 } },
        "color": "#FFFFFF",
        "letterSpacingEm": 0.12,
        "lineHeight": 1.4,
        "align": "center"
      },
      "cta": {
        "font": "gothicBold",
        "sizePct": { "$switch": { "on": "orientation", "cases": { "landscape": 3.8, "square": 3.4 }, "default": 3.2 } },
        "minSizePct": { "$switch": { "on": "orientation", "cases": { "landscape": 2.7, "square": 2.4 }, "default": 2.3 } },
        "color": "${brand.textOnPrimary}",
        "letterSpacingEm": 0.14,
        "lineHeight": 1.3,
        "align": "center"
      }
    },

    "rule": {
      "horizontal": {
        "kind": "band",
        "color": "${brand.accent}",
        "widthPct": { "$switch": { "on": "orientation", "cases": { "landscape": 7 }, "default": 11 } },
        "heightPct": { "$switch": { "on": "orientation", "cases": { "landscape": 0.72 }, "default": 0.48 } },
        "radiusPct": 0,
        "anim": "slide-right",
        "animDuration": 0.42,
        "outDuration": 0
      },
      "vertical": {
        "kind": "band",
        "color": "${brand.accent}",
        "widthPct": { "$switch": { "on": "orientation", "cases": { "landscape": 0.36 }, "default": 0.62 } },
        "heightPct": { "$switch": { "on": "orientation", "cases": { "landscape": 11 }, "default": 9 } },
        "radiusPct": 0,
        "anim": "slide-up",
        "animDuration": 0.42,
        "outDuration": 0
      }
    },

    "y": {
      "contentBottom": { "$switch": { "on": "orientation", "cases": { "landscape": -22, "square": -26 }, "default": -30 } },
      "tateTop": { "$switch": { "on": "orientation", "cases": { "landscape": 13, "square": 12 }, "default": 12 } },
      "topBlock": { "$switch": { "on": "orientation", "cases": { "landscape": 17, "square": 16 }, "default": 15 } },
      "ctaBar": { "$switch": { "on": "orientation", "cases": { "landscape": -10, "square": -13 }, "default": -17 } }
    },

    "width": {
      "text": { "$switch": { "on": "orientation", "cases": { "landscape": 58, "square": 74 }, "default": 82 } },
      "bar": { "$switch": { "on": "orientation", "cases": { "landscape": 52, "square": 74 }, "default": 82 } }
    },

    "scrimBottom": {
      "kind": "scrim",
      "side": "bottom",
      "heightPct": 58,
      "color": "#0E0B08",
      "strength": 0.82,
      "anim": "none",
      "start": 0
    },
    "scrimLeft": {
      "kind": "scrim",
      "side": "left",
      "widthPct": { "$switch": { "on": "orientation", "cases": { "landscape": 46 }, "default": 62 } },
      "color": "#0E0B08",
      "strength": 0.72,
      "anim": "none",
      "start": 0
    },
    "scrimTop": {
      "kind": "scrim",
      "side": "top",
      "heightPct": 44,
      "color": "#0E0B08",
      "strength": 0.72,
      "anim": "none",
      "start": 0
    }
  },

  "scenes": [
    {
      "id": "hook",
      "asset": "cutHook",
      "duration": { "$beats": 5 },
      "motion": "zoom-in",
      "motionIntensity": 0.6,
      "motionEase": "ease-out",
      "grade": { "$ref": "defs.grade" },
      "overlays": [
        {
          "$switch": {
            "on": "axis:typeStyle",
            "cases": {
              "tate": { "$ref": "defs.scrimLeft" },
              "yoko": { "$ref": "defs.scrimBottom" }
            }
          }
        },
        {
          "$switch": {
            "on": "axis:typeStyle",
            "cases": {
              "tate": {
                "kind": "text",
                "role": "headline",
                "id": "headline",
                "text": "${copy.hook.${axis.hook}}",
                "style": { "$ref": "defs.type.headlineTate" },
                "maxHeightPct": { "$switch": { "on": "orientation", "cases": { "landscape": 62 }, "default": 54 } },
                "maxWidthPct": 60,
                "maxLines": 2,
                "anchor": "top-left",
                "xPct": { "$ref": "defs.grid.margin" },
                "yPct": { "$ref": "defs.y.tateTop" },
                "start": 0.3,
                "anim": "slide-down",
                "animDuration": 0.44,
                "outDuration": 0.3
              },
              "yoko": {
                "kind": "text",
                "role": "headline",
                "id": "headline",
                "text": "${copy.hook.${axis.hook}}",
                "style": { "$ref": "defs.type.headlineYoko" },
                "maxWidthPct": { "$ref": "defs.width.text" },
                "maxLines": 3,
                "anchor": "bottom-left",
                "xPct": { "$ref": "defs.grid.margin" },
                "yPct": { "$ref": "defs.y.contentBottom" },
                "start": 0.3,
                "anim": "slide-up",
                "animDuration": 0.4,
                "outDuration": 0.3
              }
            }
          }
        },
        {
          "$switch": {
            "on": "axis:typeStyle",
            "cases": {
              "tate": {
                "$ref": "defs.rule.horizontal",
                "anchor": "bottom-left",
                "xPct": { "$ref": "defs.grid.margin" },
                "yPct": { "$switch": { "on": "orientation", "cases": { "landscape": -24 }, "default": -31 } },
                "start": 0.16
              },
              "yoko": {
                "$ref": "defs.rule.horizontal",
                "anchor": "top-left",
                "xPct": { "$ref": "defs.grid.margin" },
                "yPct": { "$switch": { "on": "orientation", "cases": { "landscape": 14 }, "default": 12 } },
                "start": 0.16
              }
            }
          }
        },
        {
          "$switch": {
            "on": "axis:typeStyle",
            "cases": {
              "tate": {
                "kind": "text",
                "role": "sub",
                "id": "kicker",
                "text": "${copy.kicker}",
                "style": { "$ref": "defs.type.kicker" },
                "maxWidthPct": { "$ref": "defs.width.text" },
                "maxLines": 1,
                "anchor": "bottom-left",
                "xPct": { "$ref": "defs.grid.margin" },
                "yPct": { "$switch": { "on": "orientation", "cases": { "landscape": -17 }, "default": -24 } },
                "start": 0.24,
                "anim": "slide-up",
                "animDuration": 0.36
              },
              "yoko": {
                "kind": "text",
                "role": "sub",
                "id": "kicker",
                "text": "${copy.kicker}",
                "style": { "$ref": "defs.type.kicker" },
                "maxWidthPct": { "$ref": "defs.width.text" },
                "maxLines": 1,
                "anchor": "top-left",
                "xPct": { "$ref": "defs.grid.margin" },
                "yPct": { "$switch": { "on": "orientation", "cases": { "landscape": 17 }, "default": 14.5 } },
                "start": 0.24,
                "anim": "slide-up",
                "animDuration": 0.36
              }
            }
          }
        }
      ]
    },

    {
      "id": "wide",
      "asset": "cutWide",
      "duration": { "$beats": 4 },
      "motion": "pan-right",
      "motionIntensity": 0.35,
      "motionEase": "ease-in-out",
      "transitionIn": "fade",
      "transitionDuration": { "$ref": "defs.beat.half" },
      "grade": { "$ref": "defs.grade" },
      "overlays": [
        { "$ref": "defs.scrimTop" },
        {
          "$ref": "defs.rule.vertical",
          "anchor": "top-left",
          "xPct": { "$ref": "defs.grid.margin" },
          "yPct": { "$ref": "defs.y.topBlock" },
          "start": 0.14
        },
        {
          "kind": "text",
          "role": "sub",
          "text": "${copy.benefit1}",
          "style": { "$ref": "defs.type.body" },
          "maxWidthPct": { "$ref": "defs.width.text" },
          "maxLines": 2,
          "anchor": "top-left",
          "xPct": { "$switch": { "on": "orientation", "cases": { "landscape": 11 }, "default": 12.5 } },
          "yPct": { "$ref": "defs.y.topBlock" },
          "start": 0.26,
          "anim": "slide-left",
          "animDuration": 0.4
        }
      ]
    },

    {
      "id": "mid",
      "asset": "cutMid",
      "duration": { "$beats": 3 },
      "motion": "zoom-out",
      "motionIntensity": 0.55,
      "motionEase": "ease-out",
      "transitionIn": "fade",
      "transitionDuration": { "$ref": "defs.beat.half" },
      "grade": { "$ref": "defs.grade" },
      "overlays": []
    },

    {
      "id": "detail",
      "asset": "cutDetail",
      "duration": { "$beats": 4 },
      "motion": "zoom-in",
      "motionIntensity": 0.42,
      "motionEase": "ease-in-out",
      "transitionIn": "fade",
      "transitionDuration": { "$ref": "defs.beat.half" },
      "grade": { "$ref": "defs.grade" },
      "overlays": [
        { "$ref": "defs.scrimBottom", "heightPct": 46, "strength": 0.72 },
        {
          "$ref": "defs.rule.horizontal",
          "anchor": "bottom-left",
          "xPct": { "$ref": "defs.grid.margin" },
          "yPct": { "$switch": { "on": "orientation", "cases": { "landscape": -34 }, "default": -42 } },
          "start": 0.14
        },
        {
          "kind": "text",
          "role": "sub",
          "text": "${copy.benefitQuiet}",
          "style": { "$ref": "defs.type.body" },
          "maxWidthPct": { "$switch": { "on": "orientation", "cases": { "landscape": 40 }, "default": 60 } },
          "maxLines": 2,
          "anchor": "bottom-left",
          "xPct": { "$ref": "defs.grid.margin" },
          "yPct": { "$ref": "defs.y.contentBottom" },
          "start": 0.26,
          "anim": "slide-up",
          "animDuration": 0.4
        }
      ]
    },

    {
      "id": "close",
      "asset": "cutClose",
      "duration": { "$beats": 6 },
      "motion": "zoom-in",
      "motionIntensity": 0.22,
      "motionEase": "ease-in-out",
      "transitionIn": "fade",
      "transitionDuration": { "$ref": "defs.beat.half" },
      "grade": { "brightness": 0.03, "contrast": 1.04, "saturation": 0.86, "blurPx": 0 },
      "overlays": [
        { "$ref": "defs.scrimBottom", "side": "full", "heightPct": 100, "strength": 0.22 },
        {
          "kind": "image",
          "role": "logo",
          "id": "logoLockup",
          "file": "assets/logo.png",
          "widthPct": { "$switch": { "on": "orientation", "cases": { "landscape": 20, "square": 30 }, "default": 36 } },
          "anchor": "center",
          "yPct": { "$switch": { "on": "orientation", "cases": { "landscape": -13 }, "default": -12 } },
          "start": 0.3,
          "anim": "fade",
          "animDuration": 0.6,
          "outDuration": 0
        },
        {
          "$ref": "defs.rule.horizontal",
          "widthPct": { "$switch": { "on": "orientation", "cases": { "landscape": 6 }, "default": 10 } },
          "heightPct": { "$switch": { "on": "orientation", "cases": { "landscape": 0.9 }, "default": 0.6 } },
          "anchor": "center",
          "yPct": { "$switch": { "on": "orientation", "cases": { "landscape": -4 }, "default": -4.5 } },
          "anim": "fade",
          "animDuration": 0.5,
          "start": 0.66
        },
        {
          "kind": "text",
          "role": "price",
          "text": "${copy.offer}",
          "style": { "$ref": "defs.type.offer" },
          "maxWidthPct": { "$ref": "defs.width.text" },
          "maxLines": 1,
          "anchor": "center",
          "yPct": { "$switch": { "on": "orientation", "cases": { "landscape": 4 }, "default": 3 } },
          "start": 0.84,
          "anim": "fade",
          "animDuration": 0.5,
          "outDuration": 0
        }
      ]
    }
  ],

  "overlays": [
    {
      "kind": "image",
      "role": "logo",
      "id": "logoCorner",
      "file": "assets/logo.png",
      "widthPct": { "$switch": { "on": "orientation", "cases": { "landscape": 9, "square": 12 }, "default": 14 } },
      "anchor": "top-left",
      "xPct": { "$ref": "defs.grid.margin" },
      "yPct": { "$switch": { "on": "orientation", "cases": { "landscape": 7 }, "default": 9 } },
      "start": 0.5,
      "end": 10.5,
      "anim": "fade",
      "animDuration": 0.7,
      "outDuration": 0.4,
      "opacity": 0.9
    },
    {
      "kind": "band",
      "id": "ctaBar",
      "color": "${brand.primary}",
      "widthPct": { "$ref": "defs.width.bar" },
      "heightPct": { "$switch": { "on": "orientation", "cases": { "landscape": 10.5, "square": 9 }, "default": 8 } },
      "radiusPct": 0,
      "anchor": "bottom-center",
      "yPct": { "$ref": "defs.y.ctaBar" },
      "start": { "$switch": { "on": "axis:ctaTiming", "cases": { "early": 8.25, "late": 11.25 } } },
      "anim": "slide-up",
      "animDuration": 0.4,
      "outDuration": 0
    },
    {
      "kind": "text",
      "role": "cta",
      "id": "cta",
      "text": "${copy.cta}",
      "style": { "$ref": "defs.type.cta" },
      "maxWidthPct": { "$ref": "defs.width.bar" },
      "maxLines": 1,
      "anchor": "bottom-center",
      "yPct": {
        "$switch": {
          "on": "orientation",
          "cases": { "landscape": -13.5, "square": -15.8 },
          "default": -19.2
        }
      },
      "start": { "$switch": { "on": "axis:ctaTiming", "cases": { "early": 8.37, "late": 11.37 } } },
      "anim": "slide-up",
      "animDuration": 0.4,
      "outDuration": 0
    }
  ]
}
